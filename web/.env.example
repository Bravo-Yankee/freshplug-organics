# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). See web/supabase/schema.sql for the
# tables these credentials talk to.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used locally by scripts/seed.ts (bypasses RLS to bootstrap content
# tables) - never referenced by app code, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — read by src/app/api/chat/route.ts. Never prefix this with
# NEXT_PUBLIC_, and never reference it from a Client Component.
ANTHROPIC_API_KEY=your-anthropic-api-key
