# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). See web/supabase/schema.sql for the
# tables these credentials talk to.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used locally by scripts/seed.ts (bypasses RLS to bootstrap content
# tables) - never referenced by app code, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — read by src/app/api/chat/route.ts. Never prefix this with
# NEXT_PUBLIC_, and never reference it from a Client Component.
GEMINI_API_KEY=your-gemini-api-key

# Server-only — read by src/app/api/contact/route.ts to email a
# notification to freshplugorganics@gmail.com whenever the Contact page
# form is submitted. Get a key at resend.com (free tier). If unset, the
# contact route still saves the message to Supabase (still visible in
# /admin) but silently skips the email step — see the console warning it
# logs when that happens.
RESEND_API_KEY=your-resend-api-key
